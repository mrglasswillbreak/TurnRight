# Optional local configuration. The public seed runs without these values.
# See docs/DEPLOYMENT.md and docs/CONFIGURATION.md from the repository root.

# Public browser configuration. VITE_* values are embedded in the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server/API only. Vite's development server does not emulate these APIs.
# Never expose service-role keys or dispatch credentials through VITE_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=
GITHUB_REPOSITORY=mrglasswillbreak/TurnRight
GITHUB_WORKFLOW_TOKEN=
REPORT_RATE_SALT=

# Vercel build variables; set only after confirming source redistribution rights.
SOURCE_REDISTRIBUTION_APPROVED=
# Add after the first production release, using its stable HTTPS origin.
PUBLISHED_MAP_URL=
