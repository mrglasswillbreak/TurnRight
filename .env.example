# Generated by npm run check:configuration -- --write. Contains no credentials.
# Public development: npm ci && npm run dev. No environment values are required.
# Hosted configuration: docs/CONFIGURATION.md. Full inventory: docs/ENVIRONMENT.md.
# Copy ONLY public VITE_* settings into web/.env.local. Server secrets belong in the server secret store.
# Other entries below are commented documentation: runtime providers, per-job dispatch, or optional tools.
# Do not copy job identifiers or claim tokens into global deployment configuration.

# server: Original-owner Auth UUID used during local bootstrap and hosted setup.
ADMIN_USER_ID=

# tool: Deployment identifier being verified, supplied to the verification tool.
# APPLICATION_DEPLOYMENT_ID=

# tool: Explicit apply switch for a reviewed layer-upgrade snapshot.
# APPLY_LAYER_UPGRADE=

# tool: Explicit apply switch for a reviewed UNILAG upgrade.
# APPLY_UNILAG=

# tool: Local model-editor benchmark report path.
# BENCHMARK_OUTPUT=

# worker: Campus identifier supplied per request or workflow; not a global campus restriction.
# CAMPUS_ID=

# build: Reviewed input package path for the package builder.
# CAMPUS_INPUT=

# build: Display name for the package being built.
# CAMPUS_NAME=

# build: URL slug for the package being built.
# CAMPUS_SLUG=

# local: Production marker that prevents local development commands from running.
# CI_PRODUCTION=

# tool: Exact preview-access run selected for cleanup.
# CLEANUP_RUN_ID=

# runtime: Vite-provided development boolean; not a user configuration variable.
# DEV=

# tool: Public origin used while preparing documentation screenshots.
# DOCS_PUBLIC_ORIGIN=

# tool: Required immutable layer-upgrade snapshot hash before applying.
# EXPECTED_SNAPSHOT=

# tool: Required immutable UNILAG snapshot hash before applying.
# EXPECTED_UNILAG_SNAPSHOT=

# tool: Explicit table exclusions recorded by the GIS backup tool.
# GIS_BACKUP_EXCLUDED_TABLES=

# tool: Public encryption key for a private GIS backup; the decryption key stays outside CI.
# GIS_BACKUP_PUBLIC_KEY=

# tool: Explicit GIS deployment verification mode.
# GIS_DEPLOYMENT_MODE=

# worker: Pinned local container image for network-isolated GIS processing.
# GIS_IMAGE=

# worker: Pinned local container image for network-isolated format conversion.
# GIS_IMPORT_IMAGE=

# worker: Immutable processing-job identifier supplied by dispatch.
# GIS_JOB_ID=

# tool; server/private only: Disposable test database URL; acceptance tools reject production database names.
# GIS_TEST_DATABASE_URL=

# ci: GitHub-provided runner marker.
# GITHUB_ACTIONS=

# server: Owner/repository used for authorized worker dispatch.
GITHUB_REPOSITORY=

# ci: GitHub-provided run identifier used in verification and cleanup receipts.
# GITHUB_RUN_ID=

# ci: GitHub-provided source revision used in health and verification receipts.
# GITHUB_SHA=

# ci: GitHub-provided job-summary output path.
# GITHUB_STEP_SUMMARY=

# ci; server/private only: GitHub-provided short-lived job credential; never a browser setting.
# GITHUB_TOKEN=

# server; server/private only: Repository-scoped credential with the Actions access required by worker dispatch.
GITHUB_WORKFLOW_TOKEN=

# ci: CI disables automated pull-request comments.
# GITLEAKS_ENABLE_COMMENTS=

# ci: CI disables upload of secret findings.
# GITLEAKS_ENABLE_UPLOAD_ARTIFACT=

# ci: Pinned secret-scanner binary version.
# GITLEAKS_VERSION=

# worker: Import-job identifier supplied by dispatch.
# IMPORT_ID=

# worker: Explicit repository-variable opt-in to import retention maintenance.
# IMPORT_RETENTION_ENABLED=

# worker: Source-refresh job identifier supplied by dispatch.
# JOB_ID=

# runtime: Node runtime mode; local workers reject production.
# NODE_ENV=

# runtime: npm-provided version information used by the runtime doctor.
# npm_config_user_agent=

# server: Explicit endpoint permission gate for scheduled OSM requests; defaults disabled.
OVERPASS_SCHEDULE_ALLOWED=

# worker: Authorized Overpass endpoint override for source acquisition.
OVERPASS_URL=

# build: Stable HTTPS publication origin. The local stack supplies its own loopback URL.
PUBLISHED_MAP_URL=

# worker: Independently reviewed release identifier supplied by dispatch.
# RELEASE_ID=

# worker: Authorized preview or publish operation supplied by dispatch.
# RELEASE_OPERATION=

# build: Review summary embedded in the generated package.
# RELEASE_SUMMARY=

# server; server/private only: Private salt for anonymous-report rate buckets.
REPORT_RATE_SALT=

# worker; server/private only: Per-attempt import claim token supplied by dispatch.
# RUN_TOKEN=

# worker: Source identifier supplied for a single scoped check.
# SOURCE_ID=

# tool: Python executable override for independent source-snapshot verification.
# SOURCE_PYTHON=

# build: Build gate backed by the source owner’s permission record.
SOURCE_REDISTRIBUTION_APPROVED=

# worker: Durable source-review operation identifier supplied by dispatch.
# SOURCE_REVIEW_OPERATION_ID=

# worker; server/private only: Per-attempt source-review claim token supplied by dispatch.
# SOURCE_REVIEW_RUN_TOKEN=

# server; server/private only: Private server service-role credential; never exposed to Vite.
SUPABASE_SERVICE_ROLE_KEY=

# server: Server Supabase origin for database, authentication and private storage.
SUPABASE_URL=

# tool: Previous release identifier recorded by the snapshot tool.
# SUPERSEDES_UNILAG_RELEASE=

# tool: Opt-in collection of coverage from Chromium acceptance journeys.
# TURNRIGHT_COVERAGE=

# tool: Deliberate evidence date for documentation capture.
# TURNRIGHT_DOCS_DATE=

# tool: Explicitly enables opt-in documentation capture journeys.
# TURNRIGHT_DOCS_SCREENSHOTS=

# tool: Set to 1 to include opt-in GIS documentation captures.
# TURNRIGHT_GIS_SCREENSHOTS=

# local; server/private only: Random local dispatch credential generated by local:up and kept in ignored runtime state.
# TURNRIGHT_LOCAL_DISPATCH_TOKEN=

# local: Generated loopback-only local worker-dispatch URL.
# TURNRIGHT_LOCAL_DISPATCH_URL=

# local: Enables the isolated local dispatch adapter; rejected on production hosts.
# TURNRIGHT_LOCAL_RUNTIME=

# ci: Vercel-provided deployment marker.
# VERCEL=

# ci: Vercel-provided source revision reported by health checks.
# VERCEL_GIT_COMMIT_SHA=

# ci: Deployment team/project owner identifier.
VERCEL_ORG_ID=

# ci: Deployment project identifier.
VERCEL_PROJECT_ID=

# ci; server/private only: Private deployment credential held in the GitHub secret store.
VERCEL_TOKEN=

# tool: Baseline evidence directory used by the globe verifier.
# VERIFY_BASELINE=

# tool; server/private only: Private deployment-protection bypass used only by verification tools.
# VERIFY_BYPASS=

# tool: Browser engine selected by the globe verifier.
# VERIFY_ENGINE=

# tool: Explicit deployment origin being verified.
# VERIFY_ORIGIN=

# tool: Verification receipt and screenshot directory.
# VERIFY_OUTPUT=

# tool: Campus or verification scope selected by the caller.
# VERIFY_SCOPE=

# tool: Explicit focused-verification override; cannot count as complete offline acceptance.
# VERIFY_SKIP_OFFLINE=

# build: Reviewed visual asset input path for package generation.
# VISUALS_INPUT=

# public: Set only by the isolated local server and configured-build test.
# VITE_LOCAL_DEVELOPMENT=

# public: Public Supabase anonymous key, protected by server authorization and row policies.
VITE_SUPABASE_ANON_KEY=

# public: Public Supabase project URL. Required only for hosted authentication and editing.
VITE_SUPABASE_URL=

# server: Private operational error tracking is enabled when server credentials exist; set false to disable capture. Apply migration 057 first.
ERROR_MONITORING_ENABLED=true
