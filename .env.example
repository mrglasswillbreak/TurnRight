# Public development: npm ci && npm run dev needs no credentials.
# Hosted editing: set public values in web/.env.local or your hosting build settings.
# Set server values in the server/worker secret store; Vite must never receive them.
# Complete inventory and placement: docs/CONFIGURATION.md and docs/ENVIRONMENT.md.

# Public browser configuration (copy the public pair to web/.env.local).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private hosted server configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=
REPORT_RATE_SALT=

# Hosted worker dispatch.
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_TOKEN=

# Hosted publication; set redistribution approval only with its permission record.
PUBLISHED_MAP_URL=
SOURCE_REDISTRIBUTION_APPROVED=

# Publication workflow secrets.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional OSM endpoint and explicit scheduling permission.
OVERPASS_URL=
OVERPASS_SCHEDULE_ALLOWED=
